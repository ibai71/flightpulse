# Local PostgreSQL credentials (keep .env private)
POSTGRES_DB=flightpulse
POSTGRES_USER=flightpulse
POSTGRES_PASSWORD=flightpulse_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Spark JDBC driver override
POSTGRES_JDBC_DRIVER=org.postgresql.Driver

# Kafka from the Windows host; the Compose app uses kafka:9092 internally
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=adsb-observations

# Local paths
FLIGHTPULSE_DATA_DIR=data
ADS_B_AIRPORT=KJFK
ADS_B_MAX_FLIGHTS=40
ADS_B_DATE=

# Optional Snowflake warehouse (run scripts/snowflake_setup.sql in Snowsight; password is prompted, not saved)
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=your-login
SNOWFLAKE_AUTHENTICATOR=username_password_mfa
SNOWFLAKE_ROLE=FLIGHTPULSE_ROLE
SNOWFLAKE_WAREHOUSE=FLIGHTPULSE_WH
SNOWFLAKE_DATABASE=FLIGHTPULSE
SNOWFLAKE_SCHEMA=ANALYTICS
DBT_SOURCE_SCHEMA=LANDING
