# Local PostgreSQL credentials (keep .env private)
POSTGRES_DB=flightpulse
POSTGRES_USER=flightpulse
POSTGRES_PASSWORD=flightpulse_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Spark JDBC driver override
POSTGRES_JDBC_DRIVER=org.postgresql.Driver

# Kafka, as seen by Spark/producer running in WSL2
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=adsb-observations

# Local paths
FLIGHTPULSE_DATA_DIR=data
ADS_B_AIRPORT=KJFK
ADS_B_MAX_FLIGHTS=40
ADS_B_DATE=
